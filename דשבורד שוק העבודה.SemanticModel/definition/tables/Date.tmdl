table 'Date'
	lineageTag: 6146d184-6189-5dc9-81ba-d0db1874277d
	dataCategory: Time

	column 'Date'
		dataType: dateTime
		lineageTag: b49a2348-a31e-51ec-98ba-0c844cdf2539
		isKey
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: [Date]

	column 'Year'
		dataType: int64
		lineageTag: 7e09756c-54bb-5e5f-8d43-175e95072873
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month Number'
		dataType: int64
		lineageTag: a9d0f26c-4c5d-5aa0-b07d-f1f4ffe4478a
		summarizeBy: none
		sourceColumn: [Month Number]

	column 'Quarter'
		dataType: int64
		lineageTag: 29218dce-a6bb-5e6a-9ac5-415694e78f6f
		summarizeBy: none
		sourceColumn: [Quarter]

	column 'Week Number'
		dataType: string
		lineageTag: 9c901b73-ef8f-53c4-8ed3-14542be776d1
		summarizeBy: none
		sourceColumn: [Week Number]

	column 'Year_Month'
		dataType: string
		lineageTag: ab7a2423-c226-5765-99ab-cb942e53c81a
		summarizeBy: none
		sourceColumn: [Year_Month]

	column 'DateForGraph_M'
		dataType: dateTime
		lineageTag: ef2d8b66-ddfe-5c16-abe7-e64198bf903f
		formatString: MMM yyyy
		summarizeBy: none
		sourceColumn: [DateForGraph_M]

	partition 'Date' = calculated
		mode: import
		source =
			VAR FirstDate = COALESCE(MIN('Fact'[TIME_PERIOD]), DATE(2011, 1, 1))
			VAR LastDate = COALESCE(MAX('Fact'[TIME_PERIOD]), DATE(2023, 12, 31))
			RETURN
			ADDCOLUMNS(
			    CALENDAR(FirstDate, LastDate),
			    "Year", YEAR([Date]),
			    "Month Number", MONTH([Date]),
			    "Quarter", QUARTER([Date]),
			    "Week Number", FORMAT(WEEKNUM([Date], 1), "00"),
			    "Year_Month", FORMAT([Date], "YYYY") & "-" & FORMAT(MONTH([Date]), "00"),
			    "DateForGraph_M", DATE(YEAR([Date]), MONTH([Date]), 1)
			)
